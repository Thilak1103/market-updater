[Unit]
Description=Market Updater: check today's briefing exists
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/market-updater
EnvironmentFile=/opt/market-updater/.env
Environment=MU_DATA_DIR=/opt/market-updater/data
ExecStart=/opt/market-updater/.venv/bin/python -m market_updater health
TimeoutStartSec=5min
Nice=5
